HOST=0.0.0.0                    # host that the application runs on internally
APP_PORT=3000                   # port that the application runs on internally
DOCKER_APP_IMAGE=xxxxxx         # when being used, the image that Docker compose pulls from (Docker Hub)

DB_PORT=5433                    # port that Postgres DB is accessible on
POSTGRES_USER=postgres          # name of user for logging into the Postgres DB
POSTGRES_PASSWORD=Password123!  # pwd for logging into the Postgres DB
POSTGRES_DB=qview               # name of the Postgres DB to be created/found at the Docker Volume bind mount location
DATABASE_URL='postgresql://{username}:{password}@pgdb:5433/qview?sslmode=prefer'  # connection string for Postgres DB

CLOUDFLARE_TUNNEL_TOKEN=xxxxxxxxxxxxxxxxxxxxx  # when using Cloudflare Tunnels Docker container, the key used to establish the connection

JWT_SECRET=olpl93GgnolsK7ghI8RMNU3sd6s1xYv72=  # standard JWT Secret; used for JWT encoding for auth services
FRONTEND_URL=xxxxxxxxxxxxxxxxxxxxxx            # when building with Docker compose, the URL the image's container will be served on
# Transactional email via Amazon SES (SES SMTP interface). Used for account-activation and
# password-reset emails. SES_* names are preferred; the legacy SMTP_* names below still work.
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com   # your SES region's SMTP endpoint
SES_SMTP_PORT=587                                  # 587 = STARTTLS (default), 465 = implicit TLS
SES_SMTP_USERNAME=xxxxxxxxxxxxxxxxxxxx             # SES SMTP username (from "Create SMTP credentials"; NOT an AWS access key)
SES_SMTP_PASSWORD=xxxxxxxxxxxxxxxxxxxx             # SES SMTP password (shown only once when created)
SES_FROM_ADDRESS='QView <no-reply@yourdomain.com>' # a verified SES sender identity (domain or email)
# Legacy fallbacks (used only if the SES_* vars above are unset):
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

SEED_DATA_COMMON_PASSWORD=Password123!         # common pwd used for test users when they are inserted in the DB