TEST_HOST_AND_PORT=http://localhost:3000
# The RAM-backed test Postgres from compose.test.yaml (backend/run-tests.sh starts it). Its
# password is fixed and non-secret: the port is bound to localhost and nothing real is stored.
TEST_DATABASE_URL='postgresql://postgres:qviewtest@127.0.0.1:5433/qviewtest'
# Pre-shared key the game-event tests sign with (must match common::TEST_GAMEEVENT_PSK). Set here,
# not by the tests, because changing the environment while tests run in parallel is a data race.
GAMEEVENT_PSK='test-gameevent-psk'
